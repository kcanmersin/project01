# ==========================================
# CineSocial - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- PostgreSQL ----
POSTGRES_DB=cinesocial
POSTGRES_USER=cinesocial
POSTGRES_PASSWORD=cinesocial123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- JWT Authentication ----
JWT_SECRET=your-super-secret-key-at-least-32-chars!
JWT_ISSUER=CineSocial
JWT_AUDIENCE=CineSocial
JWT_EXPIRES_HOURS=24

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=

# ---- SMTP (Email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cinesocial.com
SMTP_FROM_NAME=CineSocial

# ---- Email Verification ----
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ---- Frontend ----
FRONTEND_URL=http://localhost
VITE_API_URL=

# ---- Nginx ----
NGINX_PORT=80
