# ── JWT ───────────────────────────────────────────────────────────────────────
# Üretimde mutlaka değiştirin (örn: openssl rand -hex 32)
JWT_SECRET_KEY=swipe-news-secret-key-change-in-production

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials
# OAuth 2.0 Client ID (Web application) → Client ID
# Boş bırakılırsa audience doğrulaması atlanır (sadece geliştirme için)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Veritabanı (isteğe bağlı, varsayılan: SQLite) ────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/swipenews
